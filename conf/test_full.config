/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run EBI-Metagenomics/mag-polishing-pipeline -profile test_full,<docker/singularity> --outdir <OUTDIR>

    This is a DAG-resolution smoke test, not a data test. Every reference database is
    pointed at the project directory so that the `checkIfExists: true` calls all resolve;
    nothing here is a real database, so use it with `-preview` or `-stub-run`, never to
    produce results. A real `test` profile needs a tiny eukaryotic metagenome plus a
    Branchwater index, neither of which is small enough to ship.
----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus  : 4,
        memory: '15.GB',
        time  : '1.h'
    ]
}

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    input                      = "${projectDir}/assets/samplesheet_example.csv"
    outdir                     = 'results'

    // placeholders: present so that every file(..., checkIfExists: true) resolves
    eukcc_db                   = "${projectDir}"
    busco_db                   = "${projectDir}"
    branchwater_index          = "${projectDir}"
    branchwater_metadata_db    = "${projectDir}/nextflow.config"
    cat_db_folder              = "${projectDir}"
    cat_taxonomy_db            = "${projectDir}"
    ref_genome                 = "${projectDir}/nextflow.config"
}
