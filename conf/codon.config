/*
 * Codon (EBI HPC).
 *
 * Everything below is the union of three files from
 * github.com/EBI-Metagenomics/pipelines-nextflow-configs:
 *
 *   profile-bases/codon/base.config            executor, singularity, error strategy
 *   pipelines/miassembler/codon.config         miassembler reference data
 *   pipelines/genomes-generation/codon.config  GGP reference data
 *
 * plus EBI-Metagenomics/branchwater-nf's own nextflow.config for the index and the
 * metadata DuckDB. Those pipelines `includeConfig "../../profile-bases/codon/base.config"`
 * by a path relative to the configs repo, which does not resolve from here, so the shared
 * base is inlined instead of included. **Check this file against those four when any of
 * them changes** - it is a copy, not a link.
 *
 * Deliberate deviations from the shared base are marked "DEVIATION".
 */

params {
    singularity_cachedir     = "/hps/nobackup/rdf/metagenomics/service-team/singularity-cache/"

    // --- miassembler/codon.config ---
    reference_genomes_folder = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/reference-genomes/"
    human_reference          = "human_GCF_000001405.40"
    phix_reference           = "phiX174_GCF_000819615.1"
    diamond_db               = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/diamond_dbs/NCBI_nr/2025_01/NCBI_nr.dmnd"

    // --- genomes-generation/codon.config ---
    busco_db                 = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/busco/2024-01-08"
    eukcc_db                 = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/eukccdb/eukcc2_db_ver_1.2"
    cat_db_folder            = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/cat/CAT_prepare_20210107/2021-01-07_CAT_database/"
    cat_diamond_db           = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/cat/CAT_prepare_20210107/Diamond_2.0.6/diamond"
    cat_taxonomy_db          = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/cat/CAT_prepare_20210107/2021-01-07_taxonomy/"
    checkm2_db               = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/checkm2/1.0.1/uniref100.KO.1.dmnd"
    gunc_db                  = "/hps/nobackup/rdf/metagenomics/service-team/production/ref-dbs/genomes-pipeline/gunc_db_2.0.4.dmnd"
    gtdbtk_db                = "/hps/nobackup/rdf/metagenomics/service-team/production/ref-dbs/genomes-pipeline/release226"
    rfam_rrna_models         = "/hps/nobackup/rdf/metagenomics/service-team/production/ref-dbs/genomes-pipeline/rfams_cms"
    ref_genome               = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/reference-genomes/human_GCF_000001405.40/human_GCF_000001405.40.fna"
    centre_name              = "EMG"

    // --- branchwater-nf/nextflow.config (params.index / params.branchwater_metadata_db) ---
    branchwater_index        = "/hps/nobackup/rdf/metagenomics/service-team/ref-dbs/branchwater/rocksdb_20241128/bw_k21/index/"
    branchwater_metadata_db  = "/hps/nobackup/rdf/metagenomics/service-team/users/mbc/lucas-mags/metadata.duckdb"

    ena_cache_dir            = "/hps/nobackup/rdf/metagenomics/service-team/users/zimmer/mag-polishing-pipeline/ena_cache"
}

workDir = "/hps/nobackup/rdf/metagenomics/service-team/users/zimmer/mag-polishing-pipeline/work/"

/*******************************************/
/* profile-bases/codon/base.config, inlined */
/*******************************************/
executor {
    name              = "slurm"
    queueSize         = 75
    queueGlobalStatus = true
    submitRateLimit   = "10 sec"
    pollInterval      = "10 sec"
}

process.cache = "lenient"

singularity {
    enabled     = true
    autoMounts  = true
    cacheDir    = params.singularity_cachedir
    pullTimeout = "60 min"
    registry    = "quay.io"
    // DEVIATION: the shared base sets no runOptions. A submodule's bin/ is not on PATH,
    // so ours holds relative symlinks into pipelines/*/bin/; binding projectDir keeps
    // them resolvable inside the container whatever singularity's default binds are.
    runOptions  = "--bind ${projectDir}"
}

process.errorStrategy = {
    // Always retry on first failure (attempt 1 = first try)
    if (task.attempt == 1) {
        return 'retry'
    }

    // Check for SLURM node eviction (NODE_FAIL)
    if (task.previousException?.toString().contains("terminated for an unknown reason")) {
        return 'retry'
    }

    // After first retry, check for specific exit statuses that should trigger retry
    if (task.exitStatus in ((130..145) + 104)) {
        return 'retry'
    }

    return 'finish'
}

conda.enabled = false

// DEVIATION: the shared base sets `cleanup = true`, which deletes the work directory once
// the run completes. This is a benchmark - the intermediates are the evidence, and a
// finished run still has to be resumable with a different --n_concat_samples.
cleanup = false

nextflow.enable.moduleBinaries = true

process {
    queue = 'standard'
}
