/*
 * genomes-generation resource tiers for very large fastqs.
 *
 * Copied from pipelines/genomes-generation/requirements_xlarge_fq.config in
 * github.com/EBI-Metagenomics/pipelines-nextflow-configs, which is what
 * `-profile codon,xlarge_fq` selects when GGP runs standalone. That file lives in the
 * configs repo, not in the pipeline source, so composing GGP as a subworkflow leaves it
 * behind - hence this copy.
 *
 * Values are upstream's. What changed is the selectors: the configs repo still names
 * processes as an older GGP did, and several of those names no longer match the pinned
 * submodule, so upstream's blocks silently apply to nothing. The mapping:
 *
 *   upstream                  pinned submodule
 *   EUKCC_CONCOCT             .*:EUKCC_MERGE_CONCOCT:EUKCC
 *   EUKCC_METABAT             .*:EUKCC_MERGE_METABAT:EUKCC
 *   LINKTABLE_CONCOCT         .*:EUKCC_MERGE_CONCOCT:LINKTABLE   (process ALIGNMENT_LINKTABLE)
 *   LINKTABLE_METABAT         .*:EUKCC_MERGE_METABAT:LINKTABLE
 *   DREP                      DREP_DEREPLICATE                   (aliased _RUNS / _MAGS)
 *   GZIP                      PIGZ
 *   BINNING_REFINER           gone, no such process
 *   METABAT2_METABAT2         same name, but upstream typed `withname:` (lowercase n),
 *                             so that block never applied to anything
 *
 * Usage: -profile codon,xlarge_fq
 */

process {

    maxRetries = 3
    time       = '3d'

    withName: 'ALIGNMENT_DECONTAMINATION' {
        errorStrategy = 'retry'
        cpus          = 16
        memory        = { 256.GB * task.attempt }
        time          = { 10.h   * task.attempt }
    }

    withName: 'CONCOCT_CONCOCT' {
        cpus   = 16
        memory = { 64.GB * task.attempt }
        time   = { 48.h  * task.attempt }
    }

    withName: 'METABAT2_METABAT2' {
        cpus   = 32
        memory = { 96.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    withName: 'MAXBIN2' {
        cpus   = 32
        memory = { 72.GB  * task.attempt }
        time   = { 336.h  * task.attempt }
    }

    withName: '.*:EUKCC_MERGE_CONCOCT:LINKTABLE' {
        cpus   = { 18      * task.attempt }
        memory = { 420.GB  * task.attempt }
        time   = { 16.h    * task.attempt }
    }

    withName: '.*:EUKCC_MERGE_METABAT:LINKTABLE' {
        cpus   = { 18      * task.attempt }
        memory = { 420.GB  * task.attempt }
        time   = { 16.h    * task.attempt }
    }

    withName: '.*:EUKCC_MERGE_CONCOCT:EUKCC' {
        cpus   = 32
        memory = { 36.GB * task.attempt }
        time   = { 48.h  * task.attempt }
    }

    withName: '.*:EUKCC_MERGE_METABAT:EUKCC' {
        cpus   = 32
        memory = { 72.GB * task.attempt }
        time   = { 48.h  * task.attempt }
    }

    withName: 'FEATURED_ALIGNMENT' {
        cpus   = 32
        memory = { 450.GB * task.attempt }
        time   = { 36.h   * task.attempt }
    }

    withName: 'INDEX_FASTA' {
        cpus   = 16
        memory = { 500.GB * task.attempt }
        time   = { 10.h   * task.attempt }
    }

    withName: 'DREP_DEREPLICATE' {
        cpus   = 32
        memory = { 200.GB * task.attempt }
        time   = { 30.h   * task.attempt }
    }

    withName: 'PIGZ' {
        cpus   = 16
        memory = { 30.GB * task.attempt }
        time   = { 3.h   * task.attempt }
    }

    // inert while --skip_prok true, kept so this file stays diffable against upstream
    withName: 'CHECKM2' {
        cpus   = 16
        memory = { 300.GB * task.attempt }
        time   = { 20.h   * task.attempt }
    }

    withName: 'GTDBTK' {
        cpus   = 32
        memory = { 300.GB * task.attempt }
        time   = { 30.h   * task.attempt }
    }

    withName: 'CHECK_AND_MODIFY_READS' {
        cpus          = { 4 * task.attempt }
        memory        = { 256.GB * task.attempt }
        time          = { 6.h * task.attempt }
        maxRetries    = 3
        errorStrategy = { task.exitStatus in [137, 140] ? 'retry' : 'finish' }
    }
}
