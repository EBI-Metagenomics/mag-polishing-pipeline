/*
 * Upstream module configs first (ext.args and resources stay in sync with the
 * submodules), then our own selectors. Anything we declare here wins over the includes
 * for the directives it sets, which is how the FASTP / EUKCC style collisions between
 * the two upstream pipelines are resolved.
 */

includeConfig '../pipelines/miassembler/conf/base.config'
includeConfig '../pipelines/miassembler/conf/modules.config'
includeConfig '../pipelines/genomes-generation/config/base.config'
includeConfig '../pipelines/genomes-generation/config/modules.config'

process {

    /*
     * Both upstream base configs size every label as `{ N.GB * task.attempt }` and retry
     * on the resource-kill exit codes (130-145, 104), but with `maxRetries = 1` — one
     * doubling and then the run dies. Cycle 2 feeds metaSPAdes and GGP datasets up to
     * 11x the depth of a single sample, so give the escalation more room. Only
     * resource-killed tasks retry; `errorStrategy` still says `finish` for anything else.
     */
    maxRetries = 3

    /*
     * Collision: both pipelines ship a bare `withName: FASTP`, GGP's include lands last
     * and its publishDir is disabled unless --publish_all. Restore a per-cycle path for
     * the assembler's fastp reports.
     */
    withName: '.*:SHORT_READS_ASSEMBLER:.*:FASTP' {
        publishDir = [
            path: { "${params.outdir}/${meta.study_accession}/qc/fastp/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.{json,html,log}"
        ]
    }

    /*
     * branchwater-nf sizes all three of its processes at 4 cpus / 2 GB / 4 h flat (the
     * rocksdb index is searched from disk, so manysearch does not need the memory its
     * input size suggests). Same numbers, scaled by attempt.
     *
     * Not taken from upstream: its `errorStrategy = "ignore"`. There a dropped genome is
     * one missing row; here it is a sample that silently gets no co-assembly at all.
     */
    withName: 'SOURMASH_SKETCH|SOURMASH_MANYSEARCH|BRANCHWATER_METADATA|SELECT_BRANCHWATER_HITS' {
        cpus   = 4
        memory = { 2.GB * task.attempt }
        time   = { 4.h  * task.attempt }
        publishDir = [
            path: { "${params.outdir}/branchwater/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.csv"
        ]
    }

    withName: 'ENA_FETCH_FASTQ' {
        cpus   = 1
        memory = 2.GB
        time   = { 8.h * task.attempt }
        maxForks = 4
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
    }

    withName: 'CONCAT_FASTQ' {
        cpus   = 1
        memory = 2.GB
        time   = { 8.h * task.attempt }
        publishDir = [
            path: { "${params.outdir}/concat_datasets/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }
    // taxonomy + QC for every genome in the experiment (reference and both cycles)
    withName: 'EUKCC_SINGLE' {
        cpus   = 8
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
        // out of memory retries with more; anything else (including the exit 201 of a
        // genome with no marker genes) leaves the genome without a taxid, never kills
        // the run - see modules/local/eukcc_single
        errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/taxonomy/eukcc" },
            mode: params.publish_dir_mode,
            pattern: "*_eukcc.csv"
        ]
    }

    withName: '(.*:)?COMPARE:BUSCO' {
        cpus   = 8
        memory = { 128.GB * task.attempt }   // 128 / 256 / 384 / 512
        time   = { 12.h   * task.attempt }
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'ignore' }
        maxRetries = 3
        publishDir = [
            path: { "${params.outdir}/compare/busco" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'COLLECT_ASSEMBLIES|CALCULATE_ASSEMBLY_STATS' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
        publishDir = [ enabled: false ]
    }
}
