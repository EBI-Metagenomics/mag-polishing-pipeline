nextflow_workflow {

    name "COMPARE"
    script "../../subworkflows/local/compare/main.nf"
    workflow "COMPARE"

    // The deliverable: one row per genome, every metric keyed back to the genome basename,
    // ordered reference -> 1st cycle -> ascending N whatever order the genomes arrive in.

    def FIXTURES = "\${projectDir}/tests/subworkflows/fixtures/compare"

    test("one row per genome, ordered by source, with BUSCO, EukCC and skani") {
        options "-stub"
        when {
            params { busco_db = "${projectDir}"; busco_mode = "genome" }
            workflow {
                """
                input[0] = channel.of(
                    [ [sample: "SAMPLE_001", source: "n5", runs: "SAMPLE_001,SRR1,SRR2,SRR3,SRR4,SRR5", ani: "99.10", af_reference: "90.0"], file("${FIXTURES}/SAMPLE_001_n5_metabat2_2.fa") ],
                    [ [sample: "SAMPLE_001", source: "cycle1", runs: "SAMPLE_001", ani: "99.80", af_reference: "84.4"], file("${FIXTURES}/SAMPLE_001.fa") ],
                    [ [sample: "SAMPLE_001", source: "reference", runs: "NA", ani: "NA", af_reference: "NA"], file("${FIXTURES}/REF_001.fa") ],
                    [ [sample: "SAMPLE_001", source: "n1", runs: "SAMPLE_001,SRR1", ani: "99.72", af_reference: "81.4"], file("${FIXTURES}/SAMPLE_001_n1_metabat2_1.fa") ]
                )
                input[1] = channel.of(
                    [ "SAMPLE_001", [completeness: "66.0", contamination: "1.8"] ],
                    [ "REF_001", [completeness: "39.6", contamination: "0.4"] ]
                )
                """
            }
        }
        then {
            assert workflow.success
            def rows = path(workflow.out.metrics[0]).text.readLines()*.split('\t')
            assert rows[0] == [
                "sample", "assembly", "source", "concatenated_runs", "length", "n50", "gc_content", "n_contigs",
                "eukcc_completeness", "eukcc_contamination", "busco", "ani_reference", "af_reference"
            ]
            assert rows[1..-1].collect { it[1] } == ["REF_001.fa", "SAMPLE_001.fa", "SAMPLE_001_n1_metabat2_1.fa", "SAMPLE_001_n5_metabat2_2.fa"]
            assert rows[1..-1].collect { it[2] } == ["reference", "1st cycle", "2nd cycle n1", "2nd cycle n5"]
            assert rows[1..-1].collect { it[3] } == ["NA", "SAMPLE_001", "SAMPLE_001,SRR1", "SAMPLE_001,SRR1,SRR2,SRR3,SRR4,SRR5"]
            assert workflow.out.metrics[0].endsWith("output.tsv")

            def cycle1 = rows[2]
            assert cycle1[4..7] == ["1000", "500", "50.0", "10"]     // CALCULATE_ASSEMBLY_STATS stub
            assert cycle1[8..9] == ["66.0", "1.8"]
            assert cycle1[10].startsWith("C:90.0%")                 // BUSCO stub
            assert cycle1[11..12] == ["99.80", "84.4"]

            assert rows[1][11..12] == ["NA", "NA"]                  // the reference has no skani row
            assert rows[3][8..9] == ["NA", "NA"]                    // no EukCC row for this genome
        }
    }

    test("duplicate genome file names abort the run") {
        options "-stub"
        when {
            params { busco_db = "${projectDir}"; busco_mode = "genome" }
            workflow {
                """
                input[0] = channel.of(
                    [ [sample: "SAMPLE_001", source: "cycle1", runs: "NA", ani: "NA", af_reference: "NA"], file("${FIXTURES}/SAMPLE_001.fa") ],
                    [ [sample: "SAMPLE_002", source: "cycle1", runs: "NA", ani: "NA", af_reference: "NA"], file("${FIXTURES}/SAMPLE_001.fa") ]
                )
                input[1] = channel.of([ "SAMPLE_001", [completeness: "90.0", contamination: "1.0"] ])
                """
            }
        }
        then {
            // every metric is keyed back to the basename, so a repeat would silently
            // merge two samples' numbers
            assert workflow.failed
            assert workflow.stdout.any { it.contains("unique") } || workflow.errorReport.contains("unique")
        }
    }
}
