/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config for nf-test runs
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Every nf-test here drives a `stub:` block, so nothing real runs - but a stub task
    still claims the resources its process declares, and conf/modules.config asks for
    36 GB (EUKCC_SINGLE) and 128 GB (COMPARE:BUSCO). The local executor refuses those on
    any normal machine with "Process requirement exceeds available memory" before running
    anything, so flatten them here.

    The `.*` selector is needed: a bare `process { memory = ... }` loses to the
    `withName:` blocks in conf/modules.config.
----------------------------------------------------------------------------------------
*/

process {
    withName: '.*' {
        cpus   = 1
        memory = 1.GB
        time   = 1.h
    }
}

/*
 * No container engine. Every test here drives a `stub:` block, and those are plain
 * printf/touch/mkdir - they need no tool, so running them on the host is both faster and
 * portable, and the whole suite needs neither Docker nor the reference databases.
 */
docker.enabled      = false
singularity.enabled = false
conda.enabled       = false
