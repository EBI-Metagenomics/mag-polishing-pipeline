/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EBI-Metagenomics/mag-polishing-pipeline Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments.

    One runtime composing miassembler, genomes-generation, branchwater and compare, so
    the params block is the union of what the imported subworkflows read plus our own.
    The upstream nextflow.config files are deliberately NOT included: they carry their
    own manifest, plugins and profiles. See proposal.md.
----------------------------------------------------------------------------------------
*/

params {

    // Input options
    input                      = null

    // --- mag-polishing-pipeline ---
    n_concat_samples        = "1,2,3"   // comma separated, one co-assembly dataset per value
    ena_cache_dir           = "ena_cache" // shared fastq download cache (storeDir)
    // search Branchwater with the samplesheet genome and run cycle 2 only, see main.nf
    skip_first_assembly     = false

    // Branchwater
    branchwater_index       = null       // sourmash rocksdb index
    branchwater_metadata_db = null       // branchwater metadata duckdb
    branchwater_k           = 21
    branchwater_scaled      = 1000
    branchwater_threshold   = 0.1

    // --- miassembler (workflows/short_reads_assembler.nf) ---
    assembler                             = "metaspades"   // or "megahit"; validated in main.nf
    spades_version                        = "3.15.5"
    megahit_version                       = "1.2.9"
    spades_only_assembler                 = true
    assembly_memory                       = 100
    max_spades_retries                    = 3
    max_megahit_retries                   = 3
    short_reads_min_contig_length         = 500
    short_reads_min_contig_length_metat   = 200
    short_reads_contig_threshold          = 2
    short_reads_filter_ratio_threshold    = 0.1
    short_reads_low_reads_count_threshold = 1000
    min_qcov                              = 0.3
    // unused long read path, but miassembler's conf/modules.config reads them
    long_reads_min_read_length            = 200
    long_reads_ont_quality_threshold      = 0.8
    long_reads_pacbio_quality_threshold   = 0.9
    max_flye_retries                      = 3
    min_pid                               = 0.4
    reference_genomes_folder              = null
    human_reference                       = null
    phix_reference                        = null
    contaminant_reference                 = null
    diamond_db                            = ""
    private_study                         = false
    study_accession                       = null   // only read when meta has none
    reads_accession                       = null

    // --- genomes-generation (workflows/ggp.nf) ---
    skip_preprocessing_input = true    // our reads/assemblies are not ENA derived
    skip_decontamination     = false
    skip_prok                = true    // eukaryotes only, see proposal.md section 5
    skip_euk                 = false
    merge_pairs              = false
    min_contig_size          = 1500
    metabat2_rng_seed        = 1
    download_data            = false
    publish_all              = false
    // a filename prefix, NOT an accession, until uploads are turned on below
    ena_assembly_study_accession = "mag-polishing"
    subdir_euks              = "eukaryotes"
    subdir_proks             = "prokaryotes"
    subdir_rna               = "rna"
    subdir_taxonomy          = "taxonomy"
    subdir_stats             = "stats"
    subdir_coverage          = "coverage"
    subdir_bins              = "bins"
    subdir_mags              = "mags"

    /*
     * GGP's ENA uploader (genomes_uploader). Off, and it stays off unless someone means
     * it: `upload_mags` / `upload_bins` submit genomes to ENA for real, and this pipeline
     * builds benchmark MAGs, not a submission. main.nf refuses to start when they are on
     * and the submission metadata is not filled in.
     *
     * Turning them on needs, besides these params: the Nextflow secrets WEBIN_ACCOUNT and
     * WEBIN_PASSWORD (`nextflow secrets set ...`), and `ena_assembly_study_accession` set
     * to a real registered ENA study - `genome_upload -u` is given that value verbatim.
     * Use `test_upload = true` against ENA's test service first.
     */
    upload_mags              = false
    upload_bins              = false
    test_upload              = false   // -test / --live on ena-webin-cli
    upload_tpa               = false   // --tpa, third party annotation
    upload_force             = false   // --force, overwrite an existing submission
    metagenome               = ""      // required by genome_upload, e.g. "soil metagenome"
    biomes                   = ""
    centre_name              = ""      // -profile codon sets "EMG"

    // reference databases (set by -profile codon)
    busco_db                 = ""
    busco_mode               = "genome"
    eukcc_db                 = ""
    cat_db_folder            = ""
    cat_diamond_db           = ""
    cat_taxonomy_db          = ""
    checkm2_db               = ""
    gunc_db                  = ""
    gtdbtk_db                = ""
    rfam_rrna_models         = ""
    ref_genome               = ""   // GGP decontamination reference (read even when skipped)

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    hook_url                     = null
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gitpod {
        executor.name           = 'local'
        executor.cpus           = 4
        executor.memory         = 8.GB
        process {
            resourceLimits = [
                memory: 8.GB,
                cpus  : 4,
                time  : 1.h
            ]
        }
    }
    // EBI Codon: SLURM, Singularity and every reference database path
    codon     { includeConfig 'conf/codon.config'     }
    // genomes-generation's resource tiers for very large fastqs: -profile codon,xlarge_fq
    xlarge_fq { includeConfig 'conf/xlarge_fq.config' }
    test      { includeConfig 'conf/test.config'      }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different Institutions
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity
// independent of -profile. nf-core modules name containers without a registry, so this
// has to be set for every container engine, not just inside the singularity profile.
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'

// Export these variables to prevent local Python/R libraries from conflicting with those in the container
env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

/*
 * Off because the two upstream modules.config files carry 32 selectors for processes our
 * path never runs (long reads, prokaryotes), and the warning wall trains people to ignore
 * warnings. The cost is that a typo in one of OUR selectors is silent - check a new one
 * once with `-profile debug`, which turns this back on.
 */
nextflow.enable.configProcessNamesValidation = false

/*
 * The peak-memory numbers in report.html are how the per-process `withName` blocks in
 * conf/modules.config get calibrated with real values instead of guesses.
 */
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
    fields  = 'task_id,hash,process,tag,status,exit,attempt,cpus,memory,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'EBI-Metagenomics/mag-polishing-pipeline'
    author          = """Microbiome Informatics Team - EMBL-EBI"""
    homePage        = 'https://github.com/EBI-Metagenomics/mag-polishing-pipeline'
    description     = """Improves MAG quality by recruiting additional related samples through sequence similarity search"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    diagram         = 'docs/images/metro_map.svg'
    nextflowVersion = '!>=24.04.2'
    version         = '0.1.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.3.0' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
    help {
        enabled = true
        command = "nextflow run EBI-Metagenomics/mag-polishing-pipeline -profile <docker/singularity/codon> --input samplesheet.csv --outdir <OUTDIR>"
        fullParameter = "help_full"
        showHiddenParameter = "show_hidden"
    }
}

// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'

/*
 * Copied from miassembler/nextflow.config. miassembler's conf/modules.config calls these
 * from its publishDir saveAs closures, and Nextflow only resolves them against the root
 * project's config. Both accessions are substringed, hence the >= 7 character rule on
 * our sample ids (see CLAUDE.md).
 */
def study_reads_folder( meta = null ) {
    def reads_accession = meta?.id ?: params.reads_accession

    return study_folder( meta ) + "/" + [
        reads_accession.substring(0, 7),
        reads_accession,
    ].join("/")
}

def study_folder( meta = null ) {
    def study_accession = meta?.study_accession ?: params.study_accession
    return [
        study_accession.substring(0, 7),
        study_accession,
    ].join("/")
}
