/*
 * One cycle: reads -> assembly (miassembler) -> MAGs (genomes-generation).
 *
 * Called once per cycle with a different reads channel; aliasing the import gives each
 * cycle its own process instances (see main.nf).
 */

include { SHORT_READS_ASSEMBLER } from '../../../pipelines/miassembler/workflows/short_reads_assembler'
include { GGP                   } from '../../../pipelines/genomes-generation/workflows/ggp'

workflow ASSEMBLE_AND_BIN {

    take:
    reads  // channel: [ val(meta), [ path(fastq_1), path(fastq_2) ] ]

    main:
    SHORT_READS_ASSEMBLER( reads )

    assembly_and_reads = SHORT_READS_ASSEMBLER.out.cleaned_contigs
        .map { meta, assembly -> [meta.id, meta, assembly] }
        .join( reads.map { meta, fastqs -> [meta.id, fastqs] } )
        .map { _id, meta, assembly, fastqs -> [meta, assembly, fastqs] }

    assembly_software = assembly_and_reads
        .collectFile(name: 'assembly_software.tsv', newLine: true) { meta, _assembly, _reads ->
            "${meta.id}\t${meta.assembler}_v${meta.assembler_version}"
        }

    GGP(
        assembly_and_reads,
        Channel.empty(),  // concoct bins, generated by GGP itself
        Channel.empty(),  // metabat bins
        Channel.empty(),  // maxbin bins
        Channel.empty(),  // jgi depth
        assembly_software
    )

    emit:
    assemblies = SHORT_READS_ASSEMBLER.out.cleaned_contigs   // [ val(meta), path(fa.gz) ]
    bins       = GGP.out.euk_bins.flatten()                  // path(fa.gz), named <meta.id>_<binner>_<n>.fa.gz
    versions   = SHORT_READS_ASSEMBLER.out.versions.mix( GGP.out.versions )
}
